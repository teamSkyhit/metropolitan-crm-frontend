{
  "createBrand": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "slug": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "description": {
        "type": ["string", "null"],
        "maxLength": 2000
      },
      "logoUrl": {
        "type": ["string", "null"],
        "maxLength": 500
      },
      "bannerUrl": {
        "type": ["string", "null"],
        "maxLength": 500
      },
      "isActive": {
        "type": "boolean",
        "default": true
      },
      "sortOrder": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000000,
        "default": 0
      }
    },
    "required": ["name"]
  },
