{
  "User": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "name": {
        "type": "string"
      },
      "email": {
        "type": "string",
        "format": "email"
      },
      "role": {
        "type": "string",
        "enum": ["SUPER_ADMIN", "SALES_MANAGER"]
      },
      "isActive": {
        "type": "boolean"
      },
      "mustChangePassword": {
        "type": "boolean"
      },
      "lastLoginAt": {
        "type": ["string", "null"],
        "format": "date-time"
      },
      "createdAt": {
        "type": "string",
        "format": "date-time"
      },
      "updatedAt": {
        "type": "string",
        "format": "date-time"
      }
    },
    "required": [
      "id",
      "name",
      "email",
      "role",
      "isActive",
      "mustChangePassword",
      "lastLoginAt",
      "createdAt",
      "updatedAt"
    ]
  },
  "UserLookup": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "name": {
        "type": "string"
      },
      "role": {
        "type": "string",
        "enum": ["SUPER_ADMIN", "SALES_MANAGER"]
      }
    },
    "required": ["id", "name", "role"]
  },
  "CreateUserRequest": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 2,
        "maxLength": 100
      },
      "email": {
        "type": "string",
        "maxLength": 254,
        "format": "email"
      },
      "password": {
        "type": "string",
        "minLength": 10,
        "maxLength": 64,
        "description": "10-64 characters, at least one letter and one digit",
        "example": "Str0ngPassw0rd"
      },
      "role": {
        "type": "string",
        "enum": ["SALES_MANAGER"],
        "default": "SALES_MANAGER"
      }
    },
    "required": ["name", "email", "password"]
  },
  "UpdateUserRequest": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 2,
        "maxLength": 100
      },
      "email": {
        "type": "string",
        "maxLength": 254,
        "format": "email"
      }
    }
  },
  "SetUserStatusRequest": {
    "type": "object",
    "properties": {
      "isActive": {
        "type": "boolean"
      }
    },
    "required": ["isActive"]
  },
  "ResetUserPasswordRequest": {
    "type": "object",
    "properties": {
      "newPassword": {
        "type": "string",
        "minLength": 10,
        "maxLength": 64,
        "description": "10-64 characters, at least one letter and one digit",
        "example": "Str0ngPassw0rd"
      }
    },
    "required": ["newPassword"]
  }
}
